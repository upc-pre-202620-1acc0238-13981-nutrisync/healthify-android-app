<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Catálogo interno del sistema de diseño. Solo existe en debug (src/debug). -->
        <activity
            android:name=".core.designsystem.catalog.DesignSystemCatalogActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/catalog_launcher_label"
            android:taskAffinity="pe.edu.upc.healthify.catalog"
            android:theme="@style/Theme.Healthify"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
