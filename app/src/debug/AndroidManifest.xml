<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Design system catalog, debug builds only. It has no launcher icon, so the device shows a
            single app. Open it with:
            adb shell am start -n pe.edu.upc.healthify/.core.designsystem.catalog.DesignSystemCatalogActivity
        -->
        <activity
            android:name=".core.designsystem.catalog.DesignSystemCatalogActivity"
            android:exported="true"
            android:label="@string/catalog_launcher_label"
            android:theme="@style/Theme.Healthify"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
